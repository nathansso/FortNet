<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- FortniteReplayReader only scans assemblies whose name contains "ReplayReader"
         for export groups; this name lets it find BuildPieces.g.cs. -->
    <AssemblyName>ReplayExport.ReplayReader</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.1.0" />
  </ItemGroup>

</Project>
